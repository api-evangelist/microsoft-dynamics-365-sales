{
  "opencollection": "1.0.0",
  "info": {
    "name": "Microsoft Dataverse Web API (Dynamics 365 Sales) Accounts $batch API",
    "version": "v9.2"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://login.microsoftonline.com/common/oauth2/v2.0/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "$batch",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Execute a batch of OData operations",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{org}.api.crm.dynamics.com/api/data/v9.2/$batch"
          },
          "docs": "Execute a batch of OData operations"
        }
      ]
    }
  ],
  "bundled": true
}