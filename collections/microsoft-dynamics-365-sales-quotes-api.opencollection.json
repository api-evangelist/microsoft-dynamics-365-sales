{
  "opencollection": "1.0.0",
  "info": {
    "name": "Microsoft Dataverse Web API (Dynamics 365 Sales) Accounts Quotes API",
    "version": "v9.2"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://login.microsoftonline.com/common/oauth2/v2.0/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Quotes",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Query quotes",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{org}.api.crm.dynamics.com/api/data/v9.2/quotes"
          },
          "docs": "Query quotes"
        },
        {
          "info": {
            "name": "Create a quote",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{org}.api.crm.dynamics.com/api/data/v9.2/quotes",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a quote"
        }
      ]
    }
  ],
  "bundled": true
}